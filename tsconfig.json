{
	"compilerOptions": {
		//Strict mode
		"strict": true,
		"alwaysStrict": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"strictNullChecks": true,
		"strictBindCallApply": true,
		"strictFunctionTypes": true,
		"strictPropertyInitialization": true,
		"useUnknownInCatchVariables": true,
		"module": "CommonJS",
		"target": "ES2022",
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"allowJs": true,
		"esModuleInterop": true
	},
	"exclude": ["./node_modules"],
	"include": ["./src/**/*", "./node_modules/discord-api-types"]
}
